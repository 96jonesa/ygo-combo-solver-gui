{
  "name": "ygo-combo-solver-gui",
  "version": "0.2.0",
  "description": "Desktop GUI for ygo-combo-solver (macOS/Windows)",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:mac": "npm run check:artifacts && electron-vite build && electron-builder --mac",
    "package:win": "npm run check:artifacts && electron-vite build && electron-builder --win",
    "check:artifacts": "node scripts/check-artifacts.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Andrew Jones",
  "repository": {
    "type": "git",
    "url": "https://github.com/96jonesa/ygo-combo-solver-gui"
  }
}
